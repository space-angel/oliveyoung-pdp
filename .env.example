ANTHROPIC_API_KEY=sk-ant-...

# 라벨 검수 앱 (apps/label-review) — 없으면 로컬 JSONL 저장, 접속 코드 없음
# 라벨러에게 줄 접속 코드. 비우면 이름만으로 들어온다
LABEL_ACCESS_CODE=
# Supabase 프로젝트 URL (https://xxxx.supabase.co). 둘 다 있으면 SupabaseStore, 없으면 LocalStore
SUPABASE_URL=
# service role 키 — 서버·운영자(sync_supabase.py)에서만. anon 키가 아니다. 브라우저에 절대 내보내지 않는다
SUPABASE_SERVICE_KEY=
# 정본 파일을 건드리지 않고 시험할 때 로컬 JSONL 을 둘 디렉터리 (LocalStore 전용)
LABEL_REVIEW_DATA_DIR=
# 한 사람이 받을 수 있는 번들 수. 기본 2, 0 은 무제한
LABEL_MAX_BUNDLES=
# 손 놓은 활성 배정을 다른 사람에게 넘기는 시한(시간). 기본 48
LABEL_ASSIGNMENT_TTL_HOURS=
# 관리자 화면 키. 비어 있으면 /admin 과 /api/admin/status 는 404. 설정하면 /admin 에서 한 번 넣는다(브라우저 localStorage 에만 저장)
LABEL_ADMIN_KEY=
